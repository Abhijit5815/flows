{
  "patterns": [
    {
      "id": "route",
      "rule": {
        "pattern": "$R.$M($PATH, $$$HANDLERS)"
      },
      "constraints": {
        "M": {
          "regex": "^(get|post|put|patch|delete|head|options|all)$"
        },
        "R": {
          "not": {
            "kind": "call_expression"
          }
        }
      }
    },
    {
      "id": "route-chain",
      "rule": {
        "pattern": "$R.route($PATH)"
      }
    },
    {
      "id": "mount",
      "rule": {
        "pattern": "$R.use($$$ARGS)"
      }
    }
  ],
  "guards": {
    "libraries": { "express-jwt": 401, "passport": 401, "express-oauth2-jwt-bearer": 401 },
    "name": "auth|guard|protect|jwt|permission|role|logged.?in|signed.?in",
    "body": "\\bjwt\\b|passport\\.authenticate|\\.verify\\(|\\b40[13]\\b"
  },
  "suspects": [
    {
      "id": "handler-shaped",
      "note": "a function shaped like a request handler (req, res) that no extracted route uses",
      "rule": {
        "any": [
          {
            "kind": "function_declaration"
          },
          {
            "kind": "arrow_function"
          },
          {
            "kind": "method_definition"
          },
          {
            "kind": "function_expression"
          }
        ],
        "has": {
          "field": "parameters",
          "regex": "^\\(\\s*(req|request)\\b[^,]*,\\s*(res|response)\\b"
        }
      }
    },
    {
      "id": "computed-method",
      "note": "a route registered with a computed method name, which the route rules can't read",
      "rule": {
        "pattern": "$R[$M]($PATH, $$$HANDLERS)"
      }
    }
  ]
}
